{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and personal finance preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 100
        },
        "defaultCurrency": {
          "type": "string",
          "enum": ["USD", "BDT", "EUR", "GBP", "INR", "CAD", "AUD", "AED", "SAR", "JPY"]
        },
        "notificationsEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "defaultCurrency", "notificationsEnabled", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "An income or expense ledger entry owned by a user in a specific currency.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"]
        },
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "BDT", "EUR", "GBP", "INR", "CAD", "AUD", "AED", "SAR", "JPY"]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "note": {
          "type": "string",
          "maxLength": 240
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "month": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "type", "amount", "currency", "category", "note", "date", "month", "createdAt", "updatedAt"]
    },
    "Budget": {
      "title": "Budget",
      "description": "A monthly spending limit for a specific category and currency.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "month": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^\\d{4}-\\d{2}$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "currency": {
          "type": "string",
          "enum": ["USD", "BDT", "EUR", "GBP", "INR", "CAD", "AUD", "AED", "SAR", "JPY"]
        },
        "limitAmount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "month", "category", "currency", "limitAmount", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and currency/notification preferences."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User-scoped income and expense transactions."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "User-scoped monthly category budgets."
    }
  }
}
